summarise(
mean_speed_kmh = mean(speed_kmh, na.rm = TRUE),
median_speed_kmh = median(speed_kmh, na.rm = TRUE),
sd_speed_kmh = sd(speed_kmh, na.rm = TRUE),
min_speed_kmh = min(speed_kmh, na.rm = TRUE),
