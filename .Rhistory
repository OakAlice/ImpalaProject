ME = ME,
acc.ref.frame = acc_orientation,
positive.g = gravity_direction,
mag.ref.frame = mag_orientation,
pitch.offset = angles$pitch_deg,
roll.offset = angles$roll_deg,
yaw.offset = 0,
method = 3,
algorithm = "SAAM",
plot = FALSE))
