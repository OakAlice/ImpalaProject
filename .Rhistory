output_path <- file.path(base_path, ID, accel_type, "Clipped")
if (!dir.exists(output_path)) {
dir.create(output_path, recursive = TRUE)
}
# Save to CSV
print(paste("saving: ", output_name))
fwrite(flag_data, file.path(output_path, output_name))
}
