# Functions ---------------------------------------------------------------
reformat_clemente_data <- function(x){
dat <- fread(x)
dat <- dat[, 1:4]
colnames(dat) <- c("Time", "Accel.X", "Accel.Y", "Accel.Z")
dat$Time <- as.POSIXct((dat$Time - 719529)*86400, origin = "1970-01-01", tz = "UTC")
dat$ID <- tools::file_path_sans_ext(basename(x))
dat
}
